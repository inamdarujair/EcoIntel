# =============================================================
# EcoIntel Backend — Environment Variables
# =============================================================
# Copy this file to .env for local development.
# For production: set all vars via hosting dashboard (Render).
# NEVER commit .env or real secrets to the repository.
# =============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS ---
# Local: single origin
# Production: comma-separated if needed (e.g. https://ecointel.vercel.app)
CORS_ORIGIN=http://localhost:3000

# --- Database ---
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/ecointel
# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecointel?retryWrites=true&w=majority&appName=Cluster0

# --- LLM ---
# Google Gemini API Key (optional — system falls back to rule-based extraction if invalid)
GEMINI_API_KEY=your_gemini_api_key_here
