  "version": "1.0.0",
  "description": "Backend API and Vector Retrieval Engine for EcoIntel",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
