# =============================================================
# EcoIntel Frontend — Environment Variables
# =============================================================
# Copy this file to .env.local for local development.
# For production: set all vars via Vercel dashboard.
# NEVER commit .env.local or real secrets to the repository.
# =============================================================

# --- Backend API URL ---
# Local development:
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
# Production (set via Vercel dashboard → Project → Settings → Environment Variables):
# NEXT_PUBLIC_BACKEND_URL=https://ecointel-backend.onrender.com
